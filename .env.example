# tg-bot-go environment configuration
# Env vars use `__` as a nesting separator and mirror the Python bot
# (tg-bot) contract. All values are optional unless marked REQUIRED.
# See internal/config/config.go for defaults and validation.

# --- HTTP server ---
# Address to bind the HTTP server to.
# Default: 0.0.0.0
HTTP__HOST=0.0.0.0

# Port to bind the HTTP server to.
# Default: 8000
HTTP__PORT=8000

# Path suffix for the Telegram webhook endpoint (e.g. /webhook/secret).
# Leave empty for polling mode.
# Optional
HTTP__WEBHOOK_PATH=

# --- Redis ---
# Redis connection URL.
# Default: redis://localhost:6379
REDIS__URL=redis://localhost:6379

# Key prefix for Redis storage.
# Default: bot-005 (prod: monitor)
REDIS__PREFIX=bot-005

# --- Telegram ---
# Bot API token. REQUIRED: service refuses to start without it.
# Placeholder: replace with a real token (format: <digits>:<35 alnum chars>).
TELEGRAM__TOKEN=<YOUR_TELEGRAM_TOKEN>

# Full public webhook URL. Leave empty for polling mode.
# Optional
TELEGRAM__WEBHOOK_URL=

# --- Admin ---
# Telegram user ID of the bot admin (integer).
# Optional
ADMIN__TELEGRAM_ID=
