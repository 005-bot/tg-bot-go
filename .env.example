# tg-bot-go environment configuration
# Copy this file to .env and fill in your actual values — the service reads
# a .env file from its working directory automatically.
# Env vars use `__` as a nesting separator. Naming follows monitor-go
# conventions (single HTTP__ADDRESS, nested groups), NOT the Python bot's
# HTTP__HOST / HTTP__PORT split. All values are optional unless marked
# REQUIRED. See internal/config/config.go for defaults.
#
# Load order for the variables in this file (later overrides earlier):
#   CONFIG_PATH YAML file  ->  .env file  ->  process environment
# CONFIG_PATH, DEBUG and HTTP_PROXY/HTTPS_PROXY/NO_PROXY are read straight
# from the process environment; putting them in a .env file has no effect.
# See the last section.

# =============================================================================
# HTTP SERVER
# =============================================================================

# HTTP listen address
# Purpose: address the Fiber HTTP server binds to
# Format: host:port
# Default: 127.0.0.1:3000
# Example: 0.0.0.0:3000
HTTP__ADDRESS=127.0.0.1:3000

# Client IP header behind a proxy
# Purpose: header that carries the original client IP when the service runs
#          behind a reverse proxy
# Format: HTTP header name
# Default: X-Forwarded-For
HTTP__PROXY_HEADER=X-Forwarded-For

# Trusted proxies
# Purpose: proxies trusted to set HTTP__PROXY_HEADER; the trusted-proxy check
#          is enabled only when this list is non-empty
# Format: JSON array of bare IPs or CIDR ranges (a single bare IP also works).
#         Commas are NOT split — "a,b" becomes one entry, and host:port never
#         matches. A YAML list via CONFIG_PATH also works.
# Default: empty (proxy header ignored)
# Example: ["127.0.0.1","10.0.0.0/8"]
HTTP__PROXIES=[]

# =============================================================================
# OPENAPI (SWAGGER UI)
# =============================================================================

# OpenAPI UI toggle
# Purpose: serve the OpenAPI spec and UI at /api/v1/docs
# Format: boolean (true|false)
# Default: true
HTTP__OPENAPI__ENABLED=true

# Public host for generated docs
# Purpose: host embedded in the generated OpenAPI spec when the service runs
#          behind a reverse proxy
# Format: URL prefix with scheme
# Example: https://bot.example.com
HTTP__OPENAPI__PUBLIC_HOST=

# Public path prefix for the docs route
# Purpose: base path embedded in the generated OpenAPI spec
# Format: path prefix
# Example: /tg-bot-go
HTTP__OPENAPI__PUBLIC_PATH=

# =============================================================================
# REDIS
# =============================================================================

# Redis connection URL
# Purpose: connection used for subscriptions, conversation state and the
#          outage pub/sub channel
# Format: redis:// or rediss:// URL, optional password
# Default: redis://localhost:6379
# Example: redis://:secret@redis.example.com:6379/0
REDIS__URL=redis://localhost:6379

# Redis key prefix
# Purpose: namespace for all bot keys (subscriptions, state, outage channel)
# Format: string
# Default: bot-005
REDIS__PREFIX=bot-005

# =============================================================================
# TELEGRAM
# =============================================================================

# Bot API token
# Purpose: authenticates the bot with the Telegram Bot API; the service fails
#          at startup if it is empty or malformed
# Format: <digits>:<35 characters (letters, digits, _ and -)>
# REQUIRED — get one from https://t.me/BotFather
# Example: 123456789:AA...
TELEGRAM__TOKEN=<YOUR_TELEGRAM_TOKEN>

# SOCKS5 proxy for outgoing Telegram API calls
# Purpose: routes outbound Bot API traffic through a SOCKS5 proxy; takes
#          precedence over HTTP_PROXY/HTTPS_PROXY when set
# Format: socks5://[user:pass@]host:port (socks5h:// resolves hostnames via
#         the proxy)
# Default: empty (direct connection, falling back to HTTP_PROXY/HTTPS_PROXY)
# Example: socks5://user:pass@host:1080
TELEGRAM__PROXY_URL=

# Telegram API request timeout
# Purpose: bounds every outgoing Bot API request end to end; must outlive the
#          8s getUpdates long-poll hold or polling never completes (startup
#          validation rejects lower values)
# Format: Go duration (e.g. 30s, 1m)
# Default: 60s
TELEGRAM__TIMEOUT=60s

# Update delivery mode
# Purpose: how the bot receives updates — long polling or a webhook
# Format: polling | webhook
# Default: polling
# Webhook mode receives updates on POST /api/v1/webhook; register that URL
# with `tg-bot-go set-webhook <url>`, which takes the full public URL as its
# argument. The route performs no request authentication. If it is reachable
# from the internet, use a reverse proxy that only forwards Telegram traffic.
TELEGRAM__MODE=polling

# =============================================================================
# STREET DATABASE (ADDRESS PARSER)
# =============================================================================

# External streets database path
# Purpose: drop in a newer streets.db without rebuilding the app; empty keeps
#          the embedded database, which the parser extracts to a temporary
#          directory
# Format: file path
# Default: empty (embedded streets.db)
# Example: /var/lib/tg-bot-go/streets.db
STREETS_DB__PATH=

# =============================================================================
# ADMIN
# =============================================================================

# Admin Telegram user ID
# Purpose: chat that receives new-subscription notifications and forwarded
#          /feedback messages; 0 disables both
# Format: integer (Telegram user ID); empty parses to 0
# Default: 0
ADMIN__TELEGRAM_ID=

# =============================================================================
# REAL ENVIRONMENT ONLY — NOT READ FROM THE .env FILE
# =============================================================================
# These variables are read with os.Getenv / the HTTP client's proxy lookup
# before or outside the .env loader: a .env entry for them is silently
# ignored. Export them in the shell, the service unit, or the container
# environment. The lines below are commented out on purpose.

# YAML configuration file
# Purpose: optional YAML file loaded as the weakest configuration layer —
#          .env and process environment values override its values; a missing
#          file is skipped
# Format: file path
# Example: export CONFIG_PATH=/etc/tg-bot-go/config.yaml

# Debug logging
# Purpose: switches the zap logger from the production (JSON) config to the
#          development config; `make air` exports DEBUG=1 for live reload
# Format: boolean parsed by strconv.ParseBool (1/0, true/false, t/f)
# Default: false
# Example: export DEBUG=1

# Outbound HTTP proxy for the Telegram API client
# Purpose: standard proxy env vars honored by the serve-mode bot's HTTP
#          client; NO_PROXY exempts hosts (comma-separated). The set-webhook
#          command ignores them and honors only TELEGRAM__PROXY_URL.
# Format: proxy URL / comma-separated no-proxy list; uppercase or lowercase
#         names both work
# Example: export HTTP_PROXY=http://proxy.example.com:8080
# Example: export HTTPS_PROXY=http://proxy.example.com:8080
# Example: export NO_PROXY=localhost,127.0.0.1
