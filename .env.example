# tg-bot-go environment configuration
# Env vars use `__` as a nesting separator. Naming follows monitor-go
# conventions (single HTTP__ADDRESS, nested groups), NOT the Python bot's
# HTTP__HOST / HTTP__PORT split. All values are optional unless marked
# REQUIRED. See internal/config/config.go for defaults.
# A YAML file may be loaded instead of env vars via CONFIG_PATH.

# --- HTTP server ---
# Address to bind the HTTP server to.
# Default: 127.0.0.1:3000
HTTP__ADDRESS=127.0.0.1:3000

# Header used to determine the client IP behind a proxy.
# Default: X-Forwarded-For
HTTP__PROXY_HEADER=X-Forwarded-For

# Comma-separated list of trusted proxy addresses.
# Optional
HTTP__PROXIES=

# --- OpenAPI (Swagger UI) ---
# Whether the OpenAPI route is served.
# Default: true
HTTP__OPENAPI__ENABLED=true

# Public host used in generated OpenAPI docs (e.g. https://example.com).
# Optional
HTTP__OPENAPI__PUBLIC_HOST=

# Public path prefix for the OpenAPI route.
# Optional
HTTP__OPENAPI__PUBLIC_PATH=

# --- Redis ---
# Redis connection URL.
# Default: redis://localhost:6379
REDIS__URL=redis://localhost:6379

# Key prefix for Redis storage.
# Default: bot-005 (prod: monitor)
REDIS__PREFIX=bot-005

# --- Telegram ---
# Bot API token. REQUIRED: the service fails fast at startup if empty.
# Placeholder: replace with a real token (format: <digits>:<35 alnum chars>).
TELEGRAM__TOKEN=<YOUR_TELEGRAM_TOKEN>

# HTTP proxy URL for outbound Telegram API calls (e.g. socks5://user:pass@host:1080).
# Optional
TELEGRAM__PROXY_URL=

# Full public webhook URL. Leave empty for polling mode.
# Optional
TELEGRAM__WEBHOOK_URL=

# --- Admin ---
# Telegram user ID of the bot admin (integer). Empty parses to 0.
# Optional
ADMIN__TELEGRAM_ID=
